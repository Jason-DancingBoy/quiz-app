#!/bin/bash
# Pre-commit hook: scan staged files for secrets

set -e

# Patterns to detect common secrets
PATTERNS=(
  # API Keys (common prefixes)
  'sk-[a-zA-Z0-9]{20,}'
  'api_key\s*[:=]\s*["'\''][a-zA-Z0-9_-]{20,}["'\'']'
  'API_KEY\s*[:=]\s*["'\''][a-zA-Z0-9_-]{20,}["'\'']'
  # Generic secret patterns
  'secret\s*[:=]\s*["'\''][a-zA-Z0-9_-]{10,}["'\'']'
  'token\s*[:=]\s*["'\''][a-zA-Z0-9_-]{10,}["'\'']'
  'password\s*[:=]\s*["'\''][^"'\''\ ]{4,}["'\'']'
  'passwd\s*[:=]\s*["'\''][^"'\''\ ]{4,}["'\'']'
)

RED='\033[0;31m'
NC='\033[0m'

# Get list of staged files (excluding deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FOUND=0
for pattern in "${PATTERNS[@]}"; do
  while IFS= read -r file; do
    if grep -nHE "$pattern" "$file" 2>/dev/null; then
      FOUND=1
    fi
  done <<< "$STAGED_FILES"
done

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo -e "${RED}[SECURITY] Commit blocked: possible secrets detected in staged files.${NC}"
  echo "Use  env vars  or  .env  (gitignored) instead of hardcoded secrets."
  echo "To bypass (if false positive):  git commit --no-verify"
  exit 1
fi
